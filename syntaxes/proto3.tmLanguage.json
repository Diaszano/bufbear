{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "proto3",
  "scopeName": "source.proto",
  "patterns": [
    { "include": "#comments" },
    { "include": "#syntax" },
    { "include": "#package" },
    { "include": "#import" },
    { "include": "#option" },
    { "include": "#message" },
    { "include": "#enum" },
    { "include": "#service" },
    { "include": "#rpc" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.proto",
          "match": "//.*$"
        },
        {
          "name": "comment.block.proto",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "syntax": {
      "patterns": [
        {
          "match": "\\b(syntax)\\s*=\\s*([\"'])(proto[23])\\2\\s*;",
          "captures": {
            "1": { "name": "keyword.other.syntax.proto" },
            "2": { "name": "punctuation.definition.string.proto" },
            "3": { "name": "string.quoted.proto" }
          }
        }
      ]
    },
    "package": {
      "patterns": [
        {
          "match": "\\b(package)\\s+([a-zA-Z_][a-zA-Z0-9_.]*)\\s*;",
          "captures": {
            "1": { "name": "keyword.other.package.proto" },
            "2": { "name": "entity.name.namespace.proto" }
          }
        }
      ]
    },
    "import": {
      "patterns": [
        {
          "match": "\\b(import)\\s+(?:(weak|public)\\s+)?([\"'][^\"']+[\"'])\\s*;",
          "captures": {
            "1": { "name": "keyword.other.import.proto" },
            "2": { "name": "keyword.other.modifier.proto" },
            "3": { "name": "string.quoted.proto" }
          }
        }
      ]
    },
    "option": {
      "patterns": [
        {
          "match": "\\b(option)\\s+([a-zA-Z_][a-zA-Z0-9_.]*(?:\\.[a-zA-Z_][a-zA-Z0-9_.]*)*|\\([a-zA-Z_][a-zA-Z0-9_.]*\\))",
          "captures": {
            "1": { "name": "keyword.other.option.proto" },
            "2": { "name": "variable.other.property.proto" }
          }
        }
      ]
    },
    "message": {
      "patterns": [
        {
          "match": "\\b(message)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.message.proto" },
            "2": { "name": "entity.name.type.message.proto" }
          }
        }
      ]
    },
    "enum": {
      "patterns": [
        {
          "match": "\\b(enum)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.enum.proto" },
            "2": { "name": "entity.name.type.enum.proto" }
          }
        }
      ]
    },
    "service": {
      "patterns": [
        {
          "match": "\\b(service)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.service.proto" },
            "2": { "name": "entity.name.type.service.proto" }
          }
        }
      ]
    },
    "rpc": {
      "patterns": [
        {
          "match": "\\b(rpc)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(\\s*(stream\\s+)?([a-zA-Z0-9_.]+)\\s*\\)\\s*(returns)\\s*\\(\\s*(stream\\s+)?([a-zA-Z0-9_.]+)\\s*\\)",
          "captures": {
            "1": { "name": "keyword.other.rpc.proto" },
            "2": { "name": "entity.name.function.rpc.proto" },
            "3": { "name": "storage.modifier.stream.proto" },
            "4": { "name": "entity.name.type.proto" },
            "5": { "name": "keyword.other.returns.proto" },
            "6": { "name": "storage.modifier.stream.proto" },
            "7": { "name": "entity.name.type.proto" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.proto",
          "match": "\\b(reserved|to|max|oneof|map|extend|extensions|group)\\b"
        },
        {
          "name": "storage.modifier.proto",
          "match": "\\b(optional|repeated|required)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.proto",
          "match": "\\b(double|float|int32|int64|uint32|uint64|sint32|sint64|fixed32|fixed64|sfixed32|sfixed64|bool|string|bytes)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.proto",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.nan.proto",
          "match": "\\b(inf|nan)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.proto",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.proto",
              "match": "\\\\(?:[abfnrtv\\\\'\"]|[0-7]{1,3}|x[0-9a-fA-F]{1,2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8})"
            }
          ]
        },
        {
          "name": "string.quoted.single.proto",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.proto",
              "match": "\\\\(?:[abfnrtv\\\\'\"]|[0-7]{1,3}|x[0-9a-fA-F]{1,2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.proto",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.octal.proto",
          "match": "\\b0[0-7]+\\b"
        },
        {
          "name": "constant.numeric.float.proto",
          "match": "\\b[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.decimal.proto",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.proto",
          "match": "="
        }
      ]
    }
  }
}
