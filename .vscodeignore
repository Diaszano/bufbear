# Deny everything by default. Only the runtime and Marketplace assets below
# are included in the published VSIX package.
**/*

# Extension manifest
!package.json

# Runtime bundle
!dist/
!dist/**

# Language support required at runtime
!language-configuration.json
!syntaxes/
!syntaxes/**

# Marketplace assets
!resources/
!resources/**
!README.md
!CHANGELOG.md
!LICENSE
!THIRD_PARTY_NOTICES.md
